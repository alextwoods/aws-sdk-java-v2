<!--
  The Dynamic Client (Requirements 14.2-14.15, 14.19): a model-driven facade over the same AwsCallEngine,
  ClientRuntime, AwsClientBuildState and stages generated service clients use, with the sdk-core streaming,
  paginator and waiter runtime generated clients use. It binds dynamic-model's runtime operations to the pipeline
  (endpoint binding, modeled auth, httpChecksum, protocols, type registry) and depends on every launch protocol, the
  event stream framing, Modern Auth and the default credentials chain, so any runtime model a generated service could
  be built from can be called. The Smithy model classes it reads come from dynamic-model's API; nothing here parses a
  model, and no generated service depends on this artifact.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-dynamic</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>dynamic-client</artifactId>
    <name>AWS Java SDK V3 :: Dynamic :: Dynamic Client</name>
    <description>The V3 dynamic client facade and dynamic operation descriptors.</description>
    <dependencies>
        <!-- The shared pipeline: AwsCallEngine, ClientRuntime, AwsClientBuildState, AwsOperation. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Runtime models, service selection, runtime schemas and DynamicAwsOperation descriptors. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamic-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Runtime types the pipeline binding of a runtime operation is built from. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>retries</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>checksums</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Modern Auth and the default credentials chain, as generated services with AWS auth schemes use them. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-aws</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-providers</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Every launch protocol, selected at client construction from the runtime model's protocol traits. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-json-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-xml-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-query-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2-query-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rpcv2-cbor-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- protocol-core's optional event stream framing: generated services with event stream operations declare
             it themselves, and any runtime model may have event stream operations. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests (DynamicInputValidationPropertyTest, Property 53). Test scope only. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${v3.jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
