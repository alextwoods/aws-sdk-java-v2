<!--
  Release-reactor verification.

  * ReactorInventoryTest (every build): the release reactor contains every Requirement 1.3 artifact category and every
    aggregate profile is a dependency-closed slice of it.
  * CleanCheckoutReactorTest (release evidence): copies a clean checkout of v3/, runs the single supported command
    (mvn -f v3/pom.xml verify) in it, and asserts every module was compiled, tested, and packaged. Enable with
      mvn -f v3/pom.xml verify -Dv3.aggregate=release-evidence
    or add -Dv3.cleanCheckoutReactorTest=true to any build that includes this module.
  * JdkFailureModeFixtureTest (every build, about 30 s): forks Maven with an explicit JAVA_HOME on build fixtures in a
    clean checkout of v3/: the generated-service reactor slice and src/test/fixtures/jdk-baseline-fixture build on
    JDK 21 (always) and on every discovered GA JDK newer than 21; an older JDK, simulated on JDK 21 with
    -Dv3.minimum.jdk.version=22 (always) and every discovered installed JDK 8-20, is rejected in the validate phase
    before compilation, with no class files. Add JDK homes with -Dv3.jdkHomes=<home>:<home> (or V3_JDK_HOMES); disable
    scanning of common install locations with -Dv3.jdkDiscovery.scanWellKnownLocations=false.
  * BuildAuditTest (every build): the V3 tree invokes no Gradle executable, and every module inherits the
    validate-phase JDK check; the same BuildAudit checks every forked build's log and processes.
  * JdkMatrixReactorTest (release evidence): the full release reactor from a clean checkout on every discovered GA JDK
    newer than 21. Enabled by -Dv3.aggregate=release-evidence or -Dv3.jdkMatrixReactorTest=true.
  * CoreRuntimeSuiteReportsTest (core-runtime gate): every suite in src/test/resources/core-runtime-suites.txt wrote a
    surefire report during this Maven session with executed tests and no failures or errors. Enabled only by the
    core-runtime-gate profile below (-Dv3.aggregate=core-runtime); skipped in every other build.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>release-reactor-tests</artifactId>
    <name>AWS Java SDK V3 :: Test :: Release Reactor Tests</name>
    <description>Verifies that the single supported command builds, tests, and packages the full V3 release reactor, and the JDK, Gradle, and lifecycle-ordering failure modes of the V3 build.</description>

    <properties>
        <v3.cleanCheckoutReactorTest>false</v3.cleanCheckoutReactorTest>
        <v3.cleanCheckoutReactorTest.timeoutMinutes>60</v3.cleanCheckoutReactorTest.timeoutMinutes>
        <!-- Set to true to run the forked build with -o (for example when the outer build runs offline). -->
        <v3.cleanCheckoutReactorTest.offline>false</v3.cleanCheckoutReactorTest.offline>
        <v3.jdkMatrixReactorTest>false</v3.jdkMatrixReactorTest>
        <v3.jdkFailureModeTests.timeoutMinutes>15</v3.jdkFailureModeTests.timeoutMinutes>
        <!-- Extra JDK homes for the JDK fixtures, separated by the platform path separator. -->
        <v3.jdkHomes></v3.jdkHomes>
        <v3.jdkDiscovery.scanWellKnownLocations>true</v3.jdkDiscovery.scanWellKnownLocations>
        <v3.coreRuntimeGate>false</v3.coreRuntimeGate>
        <!-- ${maven.build.timestamp} is the Maven session start (UTC). The gate compares report modification times with
             it, so it needs millisecond precision and an explicit offset rather than the default yyyyMMdd-HHmm. -->
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</maven.build.timestamp.format>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <v3.root>${project.basedir}/../..</v3.root>
                        <v3.cleanCheckoutReactorTest>${v3.cleanCheckoutReactorTest}</v3.cleanCheckoutReactorTest>
                        <v3.cleanCheckoutReactorTest.workDirectory>${project.build.directory}/clean-checkout-reactor</v3.cleanCheckoutReactorTest.workDirectory>
                        <v3.cleanCheckoutReactorTest.timeoutMinutes>${v3.cleanCheckoutReactorTest.timeoutMinutes}</v3.cleanCheckoutReactorTest.timeoutMinutes>
                        <maven.home>${maven.home}</maven.home>
                        <v3.localRepository>${settings.localRepository}</v3.localRepository>
                        <v3.offline>${v3.cleanCheckoutReactorTest.offline}</v3.offline>
                        <v3.fixtures.directory>${project.basedir}/src/test/fixtures</v3.fixtures.directory>
                        <v3.jdkFailureModeTests.workDirectory>${project.build.directory}/jdk-failure-modes</v3.jdkFailureModeTests.workDirectory>
                        <v3.jdkFailureModeTests.timeoutMinutes>${v3.jdkFailureModeTests.timeoutMinutes}</v3.jdkFailureModeTests.timeoutMinutes>
                        <v3.jdkHomes>${v3.jdkHomes}</v3.jdkHomes>
                        <v3.jdkDiscovery.scanWellKnownLocations>${v3.jdkDiscovery.scanWellKnownLocations}</v3.jdkDiscovery.scanWellKnownLocations>
                        <v3.jdkMatrixReactorTest>${v3.jdkMatrixReactorTest}</v3.jdkMatrixReactorTest>
                        <v3.coreRuntimeGate>${v3.coreRuntimeGate}</v3.coreRuntimeGate>
                        <v3.buildStartTime>${maven.build.timestamp}</v3.buildStartTime>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release-evidence-clean-checkout</id>
            <activation>
                <property>
                    <name>v3.aggregate</name>
                    <value>release-evidence</value>
                </property>
            </activation>
            <properties>
                <v3.cleanCheckoutReactorTest>true</v3.cleanCheckoutReactorTest>
                <v3.jdkMatrixReactorTest>true</v3.jdkMatrixReactorTest>
            </properties>
        </profile>
        <profile>
            <!--
              Core-runtime suite gate (task 11.1). Enables CoreRuntimeSuiteReportsTest, which fails unless every suite in
              src/test/resources/core-runtime-suites.txt wrote a surefire report during this Maven session with executed
              tests and no failures or errors.

              The dependencies below exist only to order the reactor: each one is a module holding a required suite, so
              Maven builds (and, with -T, finishes) every such module before this one. They are type pom with every
              transitive dependency excluded, so they add nothing to the test classpath and resolve from the reactor's
              POM files in any lifecycle phase. ReactorInventoryTest keeps this list equal to the suite list's modules.
            -->
            <id>core-runtime-gate</id>
            <activation>
                <property>
                    <name>v3.aggregate</name>
                    <value>core-runtime</value>
                </property>
            </activation>
            <properties>
                <v3.coreRuntimeGate>true</v3.coreRuntimeGate>
            </properties>
