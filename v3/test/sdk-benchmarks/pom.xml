<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>sdk-benchmarks</artifactId>
    <name>AWS Java SDK V3 :: Test :: SDK Benchmarks</name>
    <description>Performance harness for the AWS SDK for Java V3. Selected by the v3-benchmarks aggregate profile.</description>

    <properties>
        <!--
          Benchmark fixture: the V3 DynamoDB model types, schemas, operation descriptors, service metadata and type
          registry are generated by aws-codegen from the reference Smithy model into
          target/generated-sources/aws-codegen. This is a test/tooling module, not the published DynamoDB service
          artifact. The model is read in place (not copied) from the local checkout of the AWS models repository; the
          revision is that checkout's commit, at which dynamodb/smithy/model.json is unmodified.
        -->
        <aws.codegen.service>com.amazonaws.dynamodb#DynamoDB_20120810</aws.codegen.service>
        <aws.codegen.packageName>software.amazon.awssdk.services.dynamodb</aws.codegen.packageName>
        <aws.codegen.modelDirectory>${project.basedir}/../../../.kiro/reference/aws-models/dynamodb/smithy</aws.codegen.modelDirectory>
        <aws.codegen.modelRevision>d45b42cbc17fe09c6600e6454e83143c96c8e685</aws.codegen.modelRevision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Generated operation descriptors are AwsOperationDescriptor constants (aws-core). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated service metadata declares the modeled protocols as ServiceProtocols (protocol-core). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The generated endpoint parameters, provider, rules and operation bindings (endpoints). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The awsJson1.0 protocol runtime: OperationProtocol serialize/deserialize is the V3 "call" today. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Sync and async HTTP SPI the arms drive directly. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The generated DynamoDB clients: the client pipeline, the SigV4 auth schemes and, without a credentials
             provider, the default credentials chain. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-aws</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-providers</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arm v3-sync-apache4. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arms v3-sync-apache5 and v3-async-apache5. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache5-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arm v3-sync-urlconnection. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arms v3-sync-crt and v3-async-crt. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-crt-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Arm v3-async-netty. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>netty-nio-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Dynamic Client paths of the forked-process harness (dynamic-sync, dynamic-async cells). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamic-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated V3 services of the harness's other protocol fixtures: awsJson1.1 (Kinesis), restJson1 (Lambda),
             restXml (Route 53), awsQuery (SNS), ec2Query (EC2) and rpcv2Cbor (CloudWatch). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kinesis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>lambda</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>route53</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated V3 services of the harness's streaming blob fixtures: S3 (restXml) and MediaStore Data
             (restJson1) PutObject/GetObject. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>mediastoredata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Build order only (the pom, no classes, nothing on any class path): the Launch Parity Baseline reference
             client is built before the forked smoke runs it, from its own target/ on its own V2-only class path
             (PerformanceReferences), including under -am. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-benchmarks-v2-reference</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>aws-codegen-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>aws-codegen-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Writes the resolved runtime classpath to target/classpath.txt so the scripts can run the harness with
                     `java -cp target/classes:$(cat target/classpath.txt)`, as racecar's classpath mode does; no shading. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sdk-benchmarks-classpath</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
