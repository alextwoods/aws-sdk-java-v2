<!--
  Bounded-memory streaming and Reactive Streams release suites (task 18.8; Requirements 5.11, 8.4, 8.5, 12.5, 19.11,
  19.14, 20.20).
  - Reactive Streams TCK (demand, cancellation, early termination) for the public body types not verified in their
    own modules: the remaining AsyncRequestBody factories, the AsyncResponseTransformer subscribers and a generated
    async paginator publisher. (The byte and file AsyncRequestBody factories, the core PagePublisher, the event-stream
    publisher and pump, the http-spi bodies and every async transport's body publisher run the TCK in their modules.)
  - StreamingBoundedMemoryTest: a 1 GiB payload through the generated MediaStore Data client, the real pipeline and a
    real transport over loopback HTTP (url-connection-client sync, netty-nio-client async), upload and download, in
    a forked JVM with a ${v3.boundedMemory.heap} heap. Exact byte count/value/order, instrumented in-flight bytes and
    demand, early close/cancel mid-stream, no OutOfMemoryError. It runs only in the bounded-memory execution below.
  Every dependency is test scope.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>bounded-memory-tests</artifactId>
    <name>AWS Java SDK V3 :: Test :: Bounded Memory Tests</name>
    <description>Bounded-memory streaming and Reactive Streams TCK release suites.</description>

    <properties>
        <!-- The heap of the bounded-memory JVM (Requirement 20.20: 256 MiB); the suite transfers 1 GiB through it and
             fails unless the payload exceeds Runtime.maxMemory(). -->
        <v3.boundedMemory.heap>256m</v3.boundedMemory.heap>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-spi</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>retries</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- restJson1 with an unsigned streaming input (PutObject), a streaming output (GetObject) and an async
             paginator (ListItems). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>mediastoredata</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The real transports of the loopback transfers. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>netty-nio-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <version>${v3.reactive-streams.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Aligns the launcher of the pinned surefire JUnit Platform provider with junit-jupiter's platform. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${v3.junit-platform.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Runs the TestNG TCK classes on JUnit Platform. -->
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <version>${v3.testng-engine.version}</version>
            <scope>test</scope>
            <!-- testng-engine is built against JUnit Platform 1.7; use the platform of junit-jupiter instead. -->
            <exclusions>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- The TCK brings TestNG, which surefire's provider auto-detection would pick over JUnit Platform,
                     silently skipping the JUnit 5 tests. Pinning the JUnit Platform provider runs every test there; the
                     TestNG TCK classes run through testng-engine. -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <excludes>
                        <exclude>**/*BoundedMemoryTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Requirements 19.11 and 20.20: the bounded-memory suite runs in its own JVM whose heap
                         (${v3.boundedMemory.heap}) is smaller than the 1 GiB payloads it transfers; the test fails
                         unless the payload exceeds Runtime.maxMemory(). A failure or timeout fails the build
                         (Requirement 19.14). -->
                    <execution>
                        <id>bounded-memory</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*BoundedMemoryTest.java</include>
                            </includes>
                            <argLine>-Xmx${v3.boundedMemory.heap}</argLine>
                            <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
                            <reportNameSuffix>bounded-memory</reportNameSuffix>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
