<!--
  The generated-versus-dynamic differential release matrix (task 18.4, Requirements 14.16, 19.6, 19.14): every launch
  protocol x call shape x sync/async cell runs the same call through a generated client and the Dynamic Client built
  from the same model AST, with fixed credentials, signing clock, idempotency tokens and retry backoff, over the same
  scripted transport, and compares the wire components and the modeled results.

  Generated clients come from two sources:
    * synthetic services (src/main/smithy/differential.smithy), one per launch protocol, generated by
      aws-codegen-maven-plugin into this module's main sources; they cover every protocol/shape combination;
    * representative fleet services, the published service artifacts of services/ (test scope), whose Dynamic Client
      loads the canonical model file vendored in that service module (services/<module>/src/main/smithy/model.json).
  This is a test module: none of the generated synthetic types is a published service artifact.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>dynamic-differential-tests</artifactId>
    <name>AWS Java SDK V3 :: Test :: Dynamic Differential Tests</name>
    <description>The generated-versus-dynamic differential matrix of every launch protocol, call shape and execution mode.</description>
    <properties>
        <v3.differential.generatedResources>${project.build.directory}/generated-resources</v3.differential.generatedResources>
        <!-- The synthetic model lives in this repository; this fixed commit ID stands in for the canonical model
             revision every real service module pins. -->
        <v3.differential.modelRevision>d1ffe7e57a11ce110000000000000000000184a0</v3.differential.modelRevision>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- The generated synthetic clients (main sources): operation descriptors, service metadata, endpoint
             bindings, clients, builders, paginators and waiters. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The synthetic services are SigV4-signed and default to the default credentials chain. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-aws</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-providers</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The seven launch protocol runtimes, discovered at client construction, and protocol-core's optional event
             stream framing. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rpcv2-cbor-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-query-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2-query-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-json-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-xml-protocol</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The Dynamic Client under test and its runtime model loader. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamic-client</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamic-model</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The representative fleet services of the matrix (see FleetCells for the selection rule): one per launch
             protocol, plus Polly for the restJson1 streaming-blob output cell. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>kinesis</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>iam</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>lambda</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>polly</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>aws-codegen-maven-plugin</artifactId>
                <version>${project.version}</version>
                <!-- One execution per synthetic service; every service shares differential.smithy. -->
                <executions>
                    <execution>
                        <id>generate-jsonzero</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#JsonZero</service>
                            <packageName>software.amazon.awssdk.test.differential.jsonzero</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/jsonzero</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/jsonzero</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-jsonone</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#JsonOne</service>
                            <packageName>software.amazon.awssdk.test.differential.jsonone</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/jsonone</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/jsonone</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-cbor</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#Cbor</service>
                            <packageName>software.amazon.awssdk.test.differential.cbor</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/cbor</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/cbor</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-query</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#Query</service>
                            <packageName>software.amazon.awssdk.test.differential.query</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/query</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/query</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-ec2</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#Ec2</service>
                            <packageName>software.amazon.awssdk.test.differential.ec2</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/ec2</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/ec2</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-restjson</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#RestJson</service>
                            <packageName>software.amazon.awssdk.test.differential.restjson</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/restjson</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/restjson</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-restxml</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <service>example.differential#RestXml</service>
                            <packageName>software.amazon.awssdk.test.differential.restxml</packageName>
                            <modelDirectory>${project.basedir}/src/main/smithy</modelDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/restxml</outputDirectory>
                            <resourceOutputDirectory>${v3.differential.generatedResources}/restxml</resourceOutputDirectory>
                            <modelRevision>${v3.differential.modelRevision}</modelRevision>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- The synthetic IDL model the plugin generated from, which the Dynamic Client loads as a
                             JSON AST. -->
                        <v3.differential.syntheticModel>${project.basedir}/src/main/smithy/differential.smithy</v3.differential.syntheticModel>
                        <!-- services/, whose modules vendor the canonical model each fleet artifact was generated
                             from. -->
                        <v3.differential.services>${project.basedir}/../../services</v3.differential.services>
                        <!-- Where the matrix report is written. -->
                        <v3.differential.report>${project.build.directory}/differential-matrix.txt</v3.differential.report>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
