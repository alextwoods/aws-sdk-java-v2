<!--
  Cross-protocol property tests of the seven launch protocol runtimes, run against random Smithy models through
  Smithy Java dynamic schemas (standing in for generated types). The reusable fixtures (random models and values,
  the canonical value oracle, the dynamic service) live under software.amazon.awssdk.test.protocols.support in the
  test sources so later protocol property tests (for example Property 13) can build on them. Test code only.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>protocol-property-tests</artifactId>
    <name>AWS Java SDK V3 :: Test :: Protocol Property Tests</name>
    <description>Property tests of the schema-driven launch protocol runtimes.</description>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-json-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rest-xml-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-query-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ec2-query-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rpcv2-cbor-protocol</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The idempotency token feature plugin, whose applied requests IdempotencyTokenStabilityPropertyTest
             serializes through the AWS JSON and REST-JSON runtimes (Property 47). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Event stream framing, which the round trip decodes to turn initial-request into initial-response. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The trait definitions and trait classes of the protocol traits the random models declare. -->
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-aws-traits</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-protocol-traits</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Smithy Java dynamic schemas stand in for generated types, as in the protocol modules' conformance
             runners. Not managed by bom-internal, which only manages the Smithy Java runtime boundary of
             smithy-runtime; the version is the same pinned Smithy Java release. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>dynamic-schemas</artifactId>
            <version>${v3.smithy-java.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
