<!--
  Deterministic pipeline fault injection (task 18.5; Requirements 19.7, 19.8, 19.14).

  src/main is the reusable fault-injection kit (package software.amazon.awssdk.test.fault): a pure-data fault trace
  (FaultTrace, generatable by property tests such as Property 63), controllable fakes for every pipeline dependency
  (FaultyHttpClient for both drivers, ScriptedIdentityProvider, FaultAuthScheme/ScriptedSigner, FaultEndpoints,
  VirtualRetryScheduler, FaultBodies), recorders (RecordingRetryStrategy, LifecycleProbe, TelemetryProbe) and
  FaultHarness, which runs one trace through the real pipeline of a generated service and returns the observed
  FaultOutcome. Test and tooling only (release="false"); no production module may depend on it.

  src/test is the release fault matrix: every required fault kind through the real AwsCallEngine on both drivers
  (PipelineFaultMatrixTest) and through generated sync and async clients of four protocols
  (GeneratedClientFaultMatrixTest). Every service dependency is test scope.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-test</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>fault-injection-tests</artifactId>
    <name>AWS Java SDK V3 :: Test :: Fault Injection Tests</name>
    <description>Deterministic pipeline fault-injection kit and the release fault matrix.</description>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- The kit (src/main): fakes of the pipeline's SPIs and a harness over the client build state. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>retries</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>telemetry-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- The release fault matrix (src/test): generated services of four protocols, plus a streaming service. -->
        <!-- awsJson1_0 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- restJson1 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>lambda</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- awsQuery -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- restXml -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>route53</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- restJson1 with a streaming input (PutObject) and a streaming output (GetObject): request and response
             body faults. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>mediastoredata</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
