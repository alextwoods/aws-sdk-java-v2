<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-codegen</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>aws-codegen-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>AWS Java SDK V3 :: Codegen :: AWS Codegen Maven Plugin</name>
    <description>The Maven lifecycle integration for aws-codegen. Contains no emitters of its own.</description>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-codegen</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Maven APIs are provided by the Maven runtime that executes the plugin. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${v3.maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${v3.maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${v3.maven-plugin-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>aws-codegen</goalPrefix>
                    <requiredJavaVersion>${v3.minimum.jdk.version}</requiredJavaVersion>
                    <requiredMavenVersion>${v3.minimum.maven.version}</requiredMavenVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
