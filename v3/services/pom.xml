    <properties>
        <!-- The full Git commit object ID of the canonical model source (https://github.com/aws/aws-models) every
             generated service module is generated from; written by v3/tools/service-fleet. -->
        <aws.models.revision>d45b42cbc17fe09c6600e6454e83143c96c8e685</aws.models.revision>
        <!-- Recorded verbatim in every service's model provenance (Requirements 2.12, 22.2). Fixture modules outside
             services/ that inherit this POM (codegen-lifecycle-tests) override it with their own revision. -->
        <aws.codegen.modelRevision>${aws.models.revision}</aws.codegen.modelRevision>
    </properties>
    <!--
      Every generated service module inherits from this POM and declares only:
        <aws.codegen.service>   absolute Smithy shape ID of the service (for example com.amazonaws.s3#AmazonS3)
        <aws.codegen.packageName>  Java package of the generated sources
        <aws.codegen.modelDigest>  digest of its vendored canonical model files at aws.models.revision
        <aws.codegen.requiredTypes>  the V2 client types it must generate (sync/async clients, builders, base
                                     exception)
      plus its protocol module dependencies and its canonical Smithy model files under src/main/smithy (bundled
      services of a V2 module get one more aws-codegen:generate execution each). aws-codegen:generate runs in
      generate-sources and registers target/generated-sources/aws-codegen as a compile source root, so generated sources
      always exist before compile (Requirement 1.4), and target/generated-resources/aws-codegen as a resource root, so
      the jar contains META-INF/aws-sdk-java-v3/services/<package>/model-provenance.json and generation-manifest.json.
      The goal skips this pom-packaged parent and fails any service module that is missing its service configuration,
      model revision or model files, whose model files do not have the pinned digest (provenance mismatch), whose model
      lacks a required AWS semantic, or whose output lacks a required type.
    -->
    <dependencies>
        <!-- The service template's required runtime edges (bom-internal dependency-policy.xml): generated model types
             are sdk-core builders and Smithy Java SerializableStructs through the smithy-runtime boundary. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated operation descriptors are AwsOperationDescriptor constants (aws-core). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated service metadata declares the modeled protocols as ServiceProtocols (protocol-core). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated clients, builders and default implementations call the AWS pipeline (aws-pipeline). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Generated builders configure the modeled AWS auth schemes (SigV4, SigV4a, bearer). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-aws</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Without a credentials provider, generated builders use DefaultCredentialsProvider. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>identity-providers</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>aws-codegen-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>aws-codegen-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
