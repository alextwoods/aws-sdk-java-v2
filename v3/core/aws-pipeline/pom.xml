<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-core</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>aws-pipeline</artifactId>
    <name>AWS Java SDK V3 :: Core :: AWS Pipeline</name>
    <description>AwsCallEngine, PipelinePlan, stages, execution context, interceptor/plugin dispatch, cancellation, timeouts, and exception mapping.</description>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>endpoints</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>retries</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>checksums</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The Telemetry SPI contract only (records, publisher, configuration); never an exporter. Its records are
             emitted only when a client configures a publisher (Requirements 15.7, 21.5). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>telemetry-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${v3.assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests (PipelineLifecyclePropertyTest, Property 29, and the later pipeline properties).
             Test scope only. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${v3.jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Event stream signing: the sign stage chain-signs an input event stream's frames with EventStreamSigner
             (EventStreamFrameSigning, loaded only for an event stream body). Optional, like protocol-core's
             eventstream dependency: services with event stream operations declare eventstream themselves, so the
             minimal service tree stays free of it. Also used by the engine's event stream tests. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
            <!-- Its dependencies are already compile dependencies here; keeping them out of this path stops Maven's
                 nearest-wins mediation from changing their scope. -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>dynamic-schemas</artifactId>
            <version>${v3.smithy-java.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <!-- Task 18.9: the stable JPMS module name (Requirement 16.10; naming rule in v3/parent/pom.xml). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.pipeline</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
