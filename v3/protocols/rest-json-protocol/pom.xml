<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-protocols</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rest-json-protocol</artifactId>
    <name>AWS Java SDK V3 :: Protocols :: REST JSON Protocol</name>
    <description>The schema-driven REST JSON protocol implementation.</description>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The JSON codec of the restJson1 body; the Smithy Java runtime version is pinned by smithy-runtime. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>json-codec</artifactId>
            <version>${v3.smithy-java.version}</version>
        </dependency>

        <!-- protocol-core's optional event stream framing, for the event stream tests. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Official Smithy AWS protocol test models, run against this runtime by RestJsonProtocolConformanceTest. -->
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-aws-protocol-tests</artifactId>
            <version>${v3.smithy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-protocol-test-traits</artifactId>
            <version>${v3.smithy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-aws-traits</artifactId>
            <version>${v3.smithy.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>dynamic-schemas</artifactId>
            <version>${v3.smithy-java.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
