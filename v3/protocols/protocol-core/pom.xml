<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-protocols</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>protocol-core</artifactId>
    <name>AWS Java SDK V3 :: Protocols :: Protocol Core</name>
    <description>Protocol selection and HTTP binding contracts.</description>
    <dependencies>
        <!-- SdkClientException, the base of the protocol selection and protocol errors. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Schema, TraitKey and OperationSchemas, from which the HTTP binding plans are derived. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SdkHttpRequest/SdkHttpResponse, the messages the protocol runtimes produce and consume. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Event stream binary framing, under the event stream SERDE of protocols.core.eventstream. Optional: only
             services with event stream operations need it at runtime, and they declare it themselves (the service
             template allows eventstream), so the minimal service tree (Requirement 15.9) stays free of it. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>eventstream</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Reactive Streams API: EventStreamPublisher and the DataStream/StreamingBody adapters implement it. -->
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
            <version>${v3.reactive-streams.version}</version>
        </dependency>
        <!-- AwsServiceException and AwsErrorDetails, the base of modeled and generic service errors. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests (design "Testing Strategy"), for example ProtocolSelectionPropertyTest (Property 11).
             This module sets test dependency versions explicitly instead of importing bom-internal; the version is
             the one bom-internal manages. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${v3.jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Dynamic schema builders and values for the HttpBindingReader/HttpBindingWriter unit tests. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>dynamic-schemas</artifactId>
            <version>${v3.smithy-java.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Reactive Streams TCK (TestNG) for EventStreamPublisher; see the surefire providers below. -->
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <version>${v3.reactive-streams.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Aligns the launcher of the pinned surefire JUnit Platform provider with junit-jupiter's platform. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${v3.junit-platform.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Runs the TestNG TCK classes on JUnit Platform. -->
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <version>${v3.testng-engine.version}</version>
            <scope>test</scope>
            <!-- testng-engine is built against JUnit Platform 1.7; use the platform of junit-jupiter instead. -->
            <exclusions>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- The TCK brings TestNG, which surefire's provider auto-detection would pick over JUnit Platform,
                     silently skipping the JUnit 5 tests. Pinning the JUnit Platform provider runs every test there; the
                     TestNG TCK classes run through testng-engine. (Surefire 3.6.0 has no surefire-testng provider.) -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
