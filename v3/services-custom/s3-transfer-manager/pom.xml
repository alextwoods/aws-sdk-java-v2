<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-services-custom</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>s3-transfer-manager</artifactId>

    <name>AWS Java SDK V3 :: Services Custom :: S3 Transfer Manager</name>
    <description>The S3 Transfer Manager high-level library.</description>

    <properties>
        <!-- The heap of the bounded-memory test JVM; S3TransferManagerBoundedMemoryTest transfers more than this. -->
        <v3.transferManager.boundedMemoryHeap>64m</v3.transferManager.boundedMemoryHeap>
    </properties>

    <!--
      Built only on public V3 APIs (design, "High-level libraries and launch parity"): the generated S3 client and model
      (s3), the async body and pagination contracts (sdk-core), request overrides (aws-core) and model schemas
      (smithy-runtime, used to carry members between related S3 shapes and to serialize resumable-transfer tokens).
      The edges are listed in bom-internal/src/main/policy/dependency-policy.xml.
    -->
    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams</artifactId>
            <version>${v3.reactive-streams.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${v3.assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Reactive Streams TCK (TestNG) for the part-body publisher; see the surefire provider below. -->
        <dependency>
            <groupId>org.reactivestreams</groupId>
            <artifactId>reactive-streams-tck</artifactId>
            <version>${v3.reactive-streams.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${v3.junit-platform.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.support</groupId>
            <artifactId>testng-engine</artifactId>
            <version>${v3.testng-engine.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The end-to-end tests run the generated S3AsyncClient over an in-JVM fake S3 transport. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-spi</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- The TCK brings TestNG, which surefire's provider auto-detection would pick over JUnit Platform,
                     silently skipping the JUnit 5 tests; pin the JUnit Platform provider (as in sdk-core). -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit-platform</artifactId>
                        <version>${maven-surefire-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <excludes>
                        <exclude>**/*BoundedMemoryTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Requirement 19.11: the bounded-memory suite runs in its own JVM whose heap
                         (${v3.transferManager.boundedMemoryHeap}) is smaller than the payloads it transfers; the
                         test fails unless the payload exceeds Runtime.maxMemory(). -->
                    <execution>
                        <id>bounded-memory</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*BoundedMemoryTest.java</include>
                            </includes>
                            <argLine>-Xmx${v3.transferManager.boundedMemoryHeap} -XX:+UseSerialGC</argLine>
                            <reportNameSuffix>bounded-memory</reportNameSuffix>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
