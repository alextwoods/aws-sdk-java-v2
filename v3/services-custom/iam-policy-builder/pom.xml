<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-services-custom</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>iam-policy-builder</artifactId>
    <name>AWS Java SDK V3 :: Services Custom :: IAM Policy Builder</name>
    <description>The IAM Policy Builder high-level library.</description>

    <!--
      The V3 port of the V2 services-custom/iam-policy-builder library (task 14.3). The public API keeps the V2 type
      names, members, JVM descriptors and builder hierarchy (software.amazon.awssdk.utils.builder from sdk-core); JSON
      reading and writing is a small internal implementation with V2's document semantics and byte-identical output,
      so the library depends on no JSON library and on no V2 or bridge artifact.
    -->
    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- ToString and the CopyableBuilder/ToCopyableBuilder builder hierarchy of the public API. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${v3.assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests of the JSON round trip. Test scope only. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${v3.jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- The V2 artifact's JPMS module name, so module-path consumers keep their requires clause. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.policybuilder.iam</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
