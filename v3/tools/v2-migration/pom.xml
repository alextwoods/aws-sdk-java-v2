<!--
  The V2-to-V3 Migration Tooling (Requirement 17.5): one artifact holding the migration engine, the recipe extension
  point, the Parity Manifest reader, the machine-readable report and the Maven plugin that runs them. It is a single
  module because the design's module table names one logical v2-migration artifact and splitting it requires
  dependency-size evidence; maven-plugin packaging still produces an ordinary jar, so the engine is usable as a library
  (for example by the migration corpus) without Maven on the class path.

  Source is parsed and attributed with the JDK's own compiler tree API (jdk.compiler), which the JDK 21 runtime that
  the tool requires always provides: exact source offsets, every source level up to 21, and attribution against the
  migrated project's own class path, so encountered members join the Parity Manifest by their exact JVM descriptor.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>v3-tools</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>v2-migration</artifactId>
    <packaging>maven-plugin</packaging>
    <name>AWS Java SDK V3 :: Tools :: V2 Migration</name>
    <description>V2-to-V3 migration engine, recipes, diagnostics, the Parity Manifest reader, and the Maven plugin that runs them.</description>

    <dependencies>
        <!-- JSON reading and writing (Smithy Node) of the Parity Manifest and the migration report: the JSON library
             the V3 tooling already uses (tools/parity-manifest, tools/service-fleet). -->
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-model</artifactId>
            <version>${v3.smithy.version}</version>
        </dependency>
        <!-- Maven APIs are provided by the Maven runtime that executes the plugin; only the mojo package uses them. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${v3.maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${v3.maven-api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${v3.maven-plugin-annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${v3.junit5.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The high-level-library parity matrix of the release tooling, bundled unchanged so the recipes report
                 its known launch gaps (APIs the manifest still claims but the candidate does not ship or verify)
                 without a copy that could drift. parity-manifest is not released, so this is a build-time resource,
                 not a dependency. -->
            <resource>
                <directory>${project.basedir}/../parity-manifest/src/main/resources/software/amazon/awssdk/tools/paritymanifest</directory>
                <includes>
                    <include>high-level-library-matrix.json</include>
                </includes>
                <targetPath>META-INF/aws-sdk-java-v3/v2-migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>v2-migration</goalPrefix>
                    <requiredJavaVersion>${v3.minimum.jdk.version}</requiredJavaVersion>
                    <requiredMavenVersion>${v3.minimum.maven.version}</requiredMavenVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
