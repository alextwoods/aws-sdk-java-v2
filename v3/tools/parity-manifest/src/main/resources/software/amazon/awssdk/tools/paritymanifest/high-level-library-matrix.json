                        "S3TransferManagerDirectoryAndCopyTest#uploadDirectory_concurrency_isBoundedByTransferDirectoryMaxConcurrency",
                        "S3TransferManagerUploadTest#uploadFile_aboveThreshold_uploadsOrderedPartsWithBoundedConcurrency",
                        "S3TransferManagerDownloadTest#downloadFile_multipartObject_fetchesEveryPartOnceWithIfMatchAndBoundedConcurrency"
