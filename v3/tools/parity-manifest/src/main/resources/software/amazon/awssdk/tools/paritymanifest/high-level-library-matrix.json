{
    "schemaVersion": 1,
    "comment": "The high-level-library parity matrix (task 14.6; Requirements 16.6-16.8, 16.12, 16.14, 16.15, 19.7-19.9, 19.12), read by HighLevelLibraryMatrix. For each library: the Parity Manifest entries it owns ('entries' globs); for the libraries with asynchronous transfers, the lifecycle aspect entries (cancellation, failure-cleanup, fault-handling, concurrency) and the test methods that verify each; and its known launch gaps. Every non-deprecated owned entry that is not a known gap must have evidence for each compatibility dimension it claims: an api: entry through the generated compatibility fixtures (source: compile and source signature/hierarchy fixtures; binary: linkage and binary signature/hierarchy fixtures; behavior/configuration and ADAPTED differences: behavior fixtures running the entry's evidence tests), any other entry through its evidence hooks; every evidence ID must be a test class of the V3 tree. A known gap must stay a gap: claimed PRESERVED or ADAPTED, non-deprecated, and without evidence, so that the launch gate keeps blocking it (NOT_SHIPPED or MISSING_EVIDENCE_HOOK) until it is implemented and verified, and is then removed from this list. Gaps may name entries other libraries or the runtime own, when the library's V2 behavior depends on them.",
    "libraries": [
        {
            "name": "dynamodb-enhanced",
            "artifact": "software.amazon.awssdk:dynamodb-enhanced",
            "entries": [
                "artifact:software.amazon.awssdk:dynamodb-enhanced",
                "api:software.amazon.awssdk.enhanced.dynamodb.*",
                "behavior:dynamodb-enhanced.*"
            ],
            "lifecycle": {
                "cancellation": {
                    "entry": "behavior:dynamodb-enhanced.async-cancellation",
                    "tests": [
                        "EnhancedClientFaultInjectionTest#cancellingAnEnhancedFutureCancelsTheHttpExchange",
                        "EnhancedClientFaultInjectionTest#cancellingAPageSubscriptionCancelsTheInFlightPageRequest",
                        "EnhancedClientFaultInjectionTest#cancellingAnItemSubscriptionStopsFetchingPages"
                    ]
                },
                "failure-cleanup": {
                    "entry": "behavior:dynamodb-enhanced.failure-cleanup",
                    "tests": [
                        "EnhancedClientFaultInjectionTest#exhaustedConnectionFailuresSurfaceAsAClientFailureAfterMaxAttempts",
                        "EnhancedClientFaultInjectionTest#modeledServiceErrorIsNotRetriedAndKeepsItsType",
                        "EnhancedClientFaultInjectionTest#cancellingAPageSubscriptionCancelsTheInFlightPageRequest"
                    ]
                },
                "fault-handling": {
                    "entry": "behavior:dynamodb-enhanced.fault-handling",
                    "tests": [
                        "EnhancedClientFaultInjectionTest#retryableTransportFaultsAreRetriedBelowTheEnhancedCall",
                        "EnhancedClientFaultInjectionTest#partialResponseBodyIsRetried",
                        "EnhancedClientFaultInjectionTest#throttlingAndServerErrorsAreRetriedThenSucceed",
                        "EnhancedClientFaultInjectionTest#persistentThrottlingSurfacesTheModeledThrottlingException",
                        "EnhancedClientFaultInjectionTest#retryDelayHintIsAppliedBetweenAttempts",
                        "EnhancedClientFaultInjectionTest#malformedSuccessResponseFailsTheEnhancedCall",
                        "EnhancedClientFaultInjectionTest#identityFailureFailsBeforeAnyRequestIsSent",
                        "EnhancedClientFaultInjectionTest#endpointFailureFailsBeforeAnyRequestIsSent"
                    ]
                },
                "concurrency": {
                    "entry": "behavior:dynamodb-enhanced.concurrency",
                    "tests": [
                        "EnhancedClientConcurrencyTest#concurrentOptimisticLockingIncrementsLoseNoUpdate",
                        "EnhancedClientConcurrencyTest#concurrentAsyncWritesAndPaginatedQueriesSeeEveryItem",
                        "EnhancedClientConcurrencyTest#concurrentAtomicCounterUpdatesAreAllApplied"
                    ]
                }
            },
            "knownGaps": [
                {
                    "entries": [
                        "api:software.amazon.awssdk.core.async.SdkPublisher#*"
                    ],
                    "reason": "The V3 sdk-core SdkPublisher declares none of the V2 operators (map, filter, limit, flatMapIterable, buffer, subscribe(Consumer), doAfterOn*, addTrailingData, adapt, fromIterable), so V2 code that applies them to PagePublisher or its items() does not compile or link."
                },
                {
                    "entries": [
                        "api:software.amazon.awssdk.services.dynamodb.model.AttributeValue#nul()*",
                        "api:software.amazon.awssdk.services.dynamodb.model.AttributeValue#fromNul(*",
                        "api:software.amazon.awssdk.services.dynamodb.model.AttributeValue#createNul(*",
                        "api:software.amazon.awssdk.services.dynamodb.model.AttributeValue$Builder#nul(*"
                    ],
                    "reason": "The generated V3 AttributeValue names the NULL member nullValue (nullValue(), fromNullValue, Builder.nullValue) instead of the V2 nul, used by custom AttributeConverters."
                },
                {
                    "entries": [
                        "behavior:errors.unmodeled-error-code"
                    ],
                    "reason": "The generated V3 DynamoDB client surfaces an unmodeled error code as AwsServiceException instead of DynamoDbException (EnhancedClientFaultInjectionTest#unmodeledServiceErrorSurfacesAsTheServiceBaseException records the V3 behavior)."
                }
            ]
        },
