{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:software.amazon.awssdk:v3:parity-manifest:1",
    "title": "AWS SDK for Java V3 Parity Manifest",
    "description": "Launch Parity Baseline inventory with exactly one Compatibility Classification per entry (Requirements 12.10, 16.1-16.3, 16.11, 16.13, 17.12). Written by ManifestJson: fixed member order, entries sorted by id, UTF-8, trailing newline. Classification-dependent field rules are enforced by ManifestValidator and mirrored in the allOf below.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "baseline", "candidate", "summary", "entries"],
    "properties": {
        "schemaVersion": { "const": 1 },
        "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["v2Version", "gitRevision", "featureFreezeCutoff", "supportStatus", "scannerVersion"],
            "properties": {
                "v2Version": { "type": "string", "minLength": 1 },
                "gitRevision": { "type": ["string", "null"] },
                "featureFreezeCutoff": { "type": ["string", "null"], "format": "date" },
                "supportStatus": { "type": ["string", "null"] },
                "scannerVersion": { "type": "string", "minLength": 1 }
            }
        },
        "candidate": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["v3Version", "gitRevision"],
            "properties": {
                "v3Version": { "type": "string", "minLength": 1 },
                "gitRevision": { "type": ["string", "null"] }
            }
        },
        "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["PRESERVED", "ADAPTED", "EXCLUDED"],
            "properties": {
                "PRESERVED": { "type": "integer", "minimum": 0 },
                "ADAPTED": { "type": "integer", "minimum": 0 },
                "EXCLUDED": { "type": "integer", "minimum": 0 }
            }
        },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
    },
    "$defs": {
        "nullableString": { "type": ["string", "null"] },
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "v2Surface", "source", "deprecated", "classification", "dimensions", "binary",
                         "rationale", "differences", "v3Artifact", "replacement", "migrationKind", "migration",
                         "supportEvidence", "evidenceIds", "evidence"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^(artifact|service|api|config|http-mode|behavior):.+$",
                    "description": "artifact:<groupId>:<artifactId> | service:<module> | api:<binaryName> | api:<binaryName>#<method><descriptor> | api:<binaryName>#<field>:<descriptor> | config:<source>:<key> | http-mode:<impl>:<sync|async> | behavior:<id>"
                },
                "kind": { "enum": ["ARTIFACT", "SERVICE", "PUBLIC_TYPE", "PUBLIC_MEMBER", "CONFIGURATION", "HTTP_MODE", "BEHAVIOR"] },
                "v2Surface": { "type": "string", "minLength": 1 },
                "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["artifact", "path"],
                    "properties": {
                        "artifact": { "type": "string", "minLength": 1 },
                        "path": { "$ref": "#/$defs/nullableString" }
                    }
                },
                "deprecated": { "type": "boolean" },
                "classification": { "enum": ["PRESERVED", "ADAPTED", "EXCLUDED"] },
                "dimensions": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "enum": ["source", "binary", "behavior", "configuration"] }
                },
                "binary": { "type": "boolean", "description": "Derived: dimensions contains binary." },
                "rationale": { "type": "string", "minLength": 1 },
                "differences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "v3Artifact": { "$ref": "#/$defs/nullableString" },
                "replacement": { "$ref": "#/$defs/nullableString", "description": "Entry ID in the candidate inventory." },
                "migrationKind": { "enum": ["RECIPE", "DIAGNOSTIC", "COMPILE_TIME", null] },
                "migration": { "$ref": "#/$defs/nullableString" },
                "supportEvidence": { "$ref": "#/$defs/nullableString" },
                "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "evidence": { "$ref": "#/$defs/nullableString", "description": "Derived: evidenceIds joined by ', ', or null." }
            },
            "allOf": [
                {
                    "if": { "properties": { "classification": { "const": "PRESERVED" } } },
                    "then": {
                        "properties": {
                            "dimensions": { "minItems": 1 },
                            "differences": { "maxItems": 0 },
                            "replacement": { "type": "null" },
                            "migrationKind": { "type": "null" },
                            "migration": { "type": "null" }
                        }
                    }
                },
                {
                    "if": { "properties": { "classification": { "const": "ADAPTED" } } },
                    "then": {
                        "properties": {
                            "differences": { "minItems": 1 },
                            "replacement": { "type": "string", "minLength": 1 },
                            "migrationKind": { "enum": ["RECIPE", "DIAGNOSTIC"] },
                            "migration": { "type": "string", "minLength": 1 },
                            "evidenceIds": { "minItems": 1 }
                        }
                    }
                },
                {
                    "if": { "properties": { "classification": { "const": "EXCLUDED" } } },
                    "then": {
                        "properties": {
                            "dimensions": { "maxItems": 0 },
                            "migrationKind": { "enum": ["COMPILE_TIME", "DIAGNOSTIC"] },
                            "migration": { "type": "string", "minLength": 1 }
                        },
                        "anyOf": [
                            { "properties": { "deprecated": { "const": true } } },
                            { "properties": { "supportEvidence": { "type": "string", "minLength": 1 } } }
                        ]
                    }
                }
            ]
        }
    }
}
