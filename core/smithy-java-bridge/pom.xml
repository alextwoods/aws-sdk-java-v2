<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>core</artifactId>
        <groupId>software.amazon.awssdk</groupId>
        <version>2.46.11-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>smithy-java-bridge</artifactId>
    <name>AWS Java SDK :: Core :: Smithy-Java Bridge</name>
    <description>
        Adapters that let the AWS SDK for Java v2 public surface run on the smithy-java
        runtime: v2 ExecutionInterceptor &lt;-&gt; smithy-java ClientInterceptor, and
        v2 SdkHttpClient -&gt; smithy-java ClientTransport. Experimental.
    </description>

    <properties>
        <smithy.java.version>1.4.2-rebased</smithy.java.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.bridge.smithyjava</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- v2 SPIs the bridges adapt. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-client-spi</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- sdk-core: SdkPojo / SdkField / MarshallingType for the v2->smithy struct adapter. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sdk-core</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>utils</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>annotations</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- v2 auth: AwsCredentialsProvider for the credentials bridge. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>auth</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- v2 aws-core: AwsServiceException, AwsClientOption, etc. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-core</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- v2 regions: Region class. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>regions</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>

        <!-- smithy-java runtime the bridges target. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-http</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>http-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>context</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>io</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- AWS protocol implementations for the smithy-java pipeline. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-awsjson</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-restjson</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-restxml</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-rpcv2</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-rpcv2-cbor</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- SigV4 signing and AWS auth for the smithy-java pipeline. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-sigv4</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-auth-api</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- AWS client core: settings, RegionSetting, etc. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-core</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- Endpoint rules engine for the smithy-java pipeline. -->
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>client-rulesengine</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.smithy.java</groupId>
            <artifactId>aws-client-rulesengine</artifactId>
            <version>${smithy.java.version}</version>
        </dependency>
        <!-- smithy-model: HttpPayloadTrait, for choosing the zero-alloc payload write path. -->
        <dependency>
            <groupId>software.amazon.smithy</groupId>
            <artifactId>smithy-model</artifactId>
            <version>1.71.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.9.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
