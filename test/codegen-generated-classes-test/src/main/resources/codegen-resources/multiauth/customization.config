{
    "skipEndpointTestGeneration": true,
    "smithyValidationSuppressions": [
        {
            "id": "HttpMethodSemantics.UnexpectedPayload",
            "reason": "Test operations send body members with GET or DELETE, to test that the SDK marshals them as C2J defines; Smithy warns that many HTTP clients do not support such payloads."
        },
        {
            "id": "RuleSetParameter.RuleSet.UnmatchedName",
            "reason": "The test rule set (shared with the other auth test models) declares StaticStringParam, OperationContextParam, BooleanClientContextParam and StringClientContextParam, which this model never binds; codegen generates them as unbound endpoint parameters."
        }
    ]
}
