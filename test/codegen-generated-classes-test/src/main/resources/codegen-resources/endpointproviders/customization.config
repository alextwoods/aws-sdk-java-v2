{
    "skipEndpointTestGeneration": true,

    "enableGenerateCompiledEndpointRules": false,
    "endpointParameters": {
        "PojoString": {
            "required": false,
            "documentation": "A string",
            "type": "String"
        },
        "BasicListOfString": {
            "required": false,
            "documentation": "A list of string keys",
            "type": "StringArray"
        },
        "WildcardKeyListOfString": {
            "required": false,
            "documentation": "A list of string from a wildcard projection",
            "type": "StringArray"
        },
        "KeysListOfString": {
            "required": false,
            "documentation": "A list of string that are map keys",
            "type": "StringArray"
        },
         "MissingRequestValuesListOfString": {
             "required": false,
             "documentation": "A list of string from a field that is not populated in the request",
             "type": "StringArray"
         }
    },
    "customOperationContextParams": [
        {
            "operationName": "NestedContainersOperation",
            "operationContextParamsMap": {
                "PojoString": {
                    "path": "Nested.StringMember"
                },
                "BasicListOfString": {
                    "path": "ListOfString"
                },
                "WildcardKeyListOfString": {
                    "path": "Nested.ListOfNested[*].StringMember"
                },
                "KeysListOfString": {
                    "path": "keys(PojoKeys)"
                },
                "MissingRequestValuesListOfString": {
                    "path": "Nested.ListOfString"
                }
            }
        }
    ],
    "smithyValidationSuppressions": [
        {
            "id": "ExclusiveStructureMemberTrait",
            "shapes": [
                "com.amazonaws.restjsonendpointproviders#IdempotentOperationStructure"
            ],
            "reason": "IdempotentOperationStructure has an idempotency token in a header, a URI label and the query string at once, to test each binding; Smithy allows one per structure."
        },
        {
            "id": "HttpMethodSemantics.UnexpectedPayload",
            "reason": "Test operations send body members with GET or DELETE, to test that the SDK marshals them as C2J defines; Smithy warns that many HTTP clients do not support such payloads."
        },
        {
            "id": "HttpUriConflict",
            "reason": "Test operations share request URIs (\"/\", \"/2016-03-11/allTypes\", ...); the client never routes by URI, and the tests check the requests it sends."
        },
        {
            "id": "RuleSetParameter.RuleSet.UnmatchedName",
            "reason": "The rule set names the parameter StaticStringParam and the operations' static context parameter is staticStringParam; codegen matches them ignoring case (both become the staticStringParam builder method), Smithy does not."
        },
        {
            "id": "StreamingTrait",
            "shapes": [
                "com.amazonaws.restjsonendpointproviders#StructureWithStreamingMember"
            ],
            "reason": "StructureWithStreamingMember is both the input and the output of the streaming test operations; Smithy allows a @requiresLength stream only in inputs."
        }
    ]
}
