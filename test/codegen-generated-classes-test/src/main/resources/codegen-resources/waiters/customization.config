{
    "skipEndpointTestGeneration": true,
    "smithyValidationSuppressions": [
        {
            "id": "ExclusiveStructureMemberTrait",
            "shapes": [
                "com.amazonaws.restjsonwithwaiters#IdempotentOperationStructure"
            ],
            "reason": "IdempotentOperationStructure has an idempotency token in a header, a URI label and the query string at once, to test each binding; Smithy allows one per structure."
        },
        {
            "id": "HttpMethodSemantics.UnexpectedPayload",
            "reason": "Test operations send body members with GET or DELETE, to test that the SDK marshals them as C2J defines; Smithy warns that many HTTP clients do not support such payloads."
        },
        {
            "id": "StreamingTrait",
            "shapes": [
                "com.amazonaws.restjsonwithwaiters#StructureWithStreamingMember"
            ],
            "reason": "StructureWithStreamingMember is both the input and the output of the streaming test operations; Smithy allows a @requiresLength stream only in inputs."
        },
        {
            "id": "WaitableTrait",
            "shapes": [
                "com.amazonaws.restjsonwithwaiters#AllTypes"
            ],
            "reason": "Test waiters (ErrorMatcherWithExpectedTrueFails, ...) have only failure and retry acceptors, to test that the waiter fails or runs out of attempts; Smithy requires a success acceptor."
        }
    ]
}
