{
    "verifiedSimpleMethods" : [
        "allTypes",
        "deleteOperation",
        "mapOfStringToListOfStringInQueryParams",
        "membersInHeaders",
        "membersInQueryParams",
        "operationWithExplicitPayloadStructure",
        "operationWithExplicitPayloadBlob",
        "operationWithModeledContentType",
        "operationWithNoInputOrOutput",
        "queryParamWithoutValue",
        "headOperation",
        "jsonValuesOperation",
        "nestedContainers"
    ],
    "customResponseMetadata": {
        "FOO_ID" : "x-foo-id",
        "BAR_ID" : "x-bar-id",
        "REQUEST_ID": "x-foobar-id"
    },
    "skipEndpointTestGeneration": true,
    "requiredTraitValidationEnabled": true,
    "delegateAsyncClientClass": true,
    "delegateSyncClientClass": true,
    "endpointParameters": {
        "Tables": {
          "required": false,
          "type": "StringArray"
        }
    },
    "customOperationContextParams": [
      {
        "operationName": "GetOperationWithMapEndpointParam",
        "operationContextParamsMap": {
          "Tables": {
            "path" : "keys(MapOfStrings)"
          }
        }
      }
    ],
    "smithyValidationSuppressions": [
        {
            "id": "ExclusiveStructureMemberTrait",
            "shapes": [
                "com.amazonaws.amazonprotocolrestjson#IdempotentOperationStructure"
            ],
            "reason": "IdempotentOperationStructure has an idempotency token in a header, a URI label and the query string at once, to test each binding; Smithy allows one per structure."
        },
        {
            "id": "HttpMethodSemantics.UnexpectedPayload",
            "reason": "Test operations send body members with GET or DELETE, to test that the SDK marshals them as C2J defines; Smithy warns that many HTTP clients do not support such payloads."
        },
        {
            "id": "HttpUriConflict",
            "reason": "Test operations share request URIs (\"/\", \"/2016-03-11/allTypes\", ...); the client never routes by URI, and the tests check the requests it sends."
        },
        {
            "id": "SdkServiceId",
            "reason": "The test service ID `AmazonProtocolRestJson` contains a company name, which Smithy's SDK ID rules forbid; generated client and package names derive from it and the tests use them."
        },
        {
            "id": "TraitValue",
            "shapes": [
                "com.amazonaws.amazonprotocolrestjson#OperationWithCustomRequestChecksum"
            ],
            "reason": "The response checksum algorithms are lowercase (crc32, sha256, ...); codegen copies them unchanged and the SDK matches them ignoring case, while Smithy only accepts the uppercase names."
        }
    ]
}
