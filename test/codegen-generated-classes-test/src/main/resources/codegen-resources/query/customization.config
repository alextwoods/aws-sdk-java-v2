{
    "skipEndpointTestGeneration": true,
    "smithyValidationSuppressions": [
        {
            "id": "ExclusiveStructureMemberTrait",
            "shapes": [
                "com.amazonaws.amazonprotocolquery#IdempotentOperationStructure"
            ],
            "reason": "IdempotentOperationStructure has an idempotency token in a header, a URI label and the query string at once, to test each binding; Smithy allows one per structure."
        },
        {
            "id": "SdkServiceId",
            "reason": "The test service ID `AmazonProtocolQuery` contains a company name, which Smithy's SDK ID rules forbid; generated client and package names derive from it and the tests use them."
        }
    ]
}
