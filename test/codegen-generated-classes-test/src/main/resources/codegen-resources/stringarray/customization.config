{
    "skipEndpointTestGeneration": true,
    "enableGenerateCompiledEndpointRules": true,
    "smithyValidationSuppressions": [
        {
            "id": "RuleSetTestCase",
            "reason": "Endpoint test cases pass an empty stringArray parameter, whose element type Smithy cannot infer."
        },
        {
            "id": "RuleSetParameter.TestCase.RequiredMissing",
            "reason": "The stringArray endpoint test cases set only the parameters they test, not the required Region."
        },
        {
            "id": "RuleSetParameter.TestCase.Unused",
            "reason": "The stringArray endpoint test cases set only the parameters they test, not Region."
        },
        {
            "id": "SdkServiceId",
            "reason": "The test service ID `StringArrayService` ends with \"Service\", which Smithy's SDK ID rules forbid; generated client and package names derive from it and the tests use them."
        }
    ]
}
