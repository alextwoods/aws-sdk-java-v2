<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>aws-sdk-java-pom</artifactId>
        <version>2.49.7-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>size-report</artifactId>
    <name>AWS Java SDK :: Test :: Size Report</name>
    <description>Compares the artifact sizes of the Baseline_Build and the feature build for the schema-serde
        Prototype_Service_Set and checks docs/design/schema-serde/size-report.md (Requirement 36).
    </description>
    <url>https://aws.amazon.com/sdkforjava</url>
    <properties>
        <size-report.asm.version>9.7</size-report.asm.version>
        <!--
          The Baseline_Build: the merge base of this branch, built by scripts/schema-serde/build-size-baseline.sh
          into size-report.baselineDir (see README.md).
        -->
        <size-report.baselineCommit>fc8b74e9fe21</size-report.baselineCommit>
        <size-report.baselineDir>${user.home}/.cache/aws-sdk-java-v2/size-baseline/${size-report.baselineCommit}</size-report.baselineDir>
        <!--
          The Prototype_Service_Set services in the report: artifactId=display name, comma-separated, in report order.
          Each display name is the one disabled-customizations.md uses.
        -->
        <size-report.services>sqs=SQS,secretsmanager=Secrets Manager,account=Account,route53=Route 53,sns=SNS,cloudwatch=CloudWatch,dynamodb=DynamoDB</size-report.services>
        <!--
          The higher-level libraries of the Library_Integration_Analysis (design D.7, task 11.23) in the report:
          artifactId=display name, comma-separated, in report order.
        -->
        <size-report.libraries>s3-event-notifications=S3 Event Notifications,sns-message-manager=SNS Message Manager,message-payloads=Message payloads</size-report.libraries>
        <!-- true: rewrite size-report.md instead of failing when it is out of date -->
        <size-report.update>false</size-report.update>
        <size-report.docsDir>${project.basedir}/../../docs/design/schema-serde</size-report.docsDir>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom-internal</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>annotations</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${size-report.asm.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>${size-report.asm.version}</version>
        </dependency>

        <!--
          The feature build of each reported service. Test scope: the report reads the JARs (copied below with their
          software.amazon.awssdk runtime dependencies) as files and never loads their classes.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>account</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>route53</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The feature build of each reported library (size-report.libraries), read the same way. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3-event-notifications</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sns-message-manager</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>message-payloads</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.jqno.equalsverifier</groupId>
            <artifactId>equalsverifier</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.sizereport</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <!--
                      The attribution names schema and protocol-core types (ExceptionMetadata) as class-file descriptor
                      strings; the analyzer reads those as uses of these modules, which are only on the test classpath
                      (through the services).
                    -->
                    <ignoredUsedUndeclaredDependencies combine.children="append">
                        <ignoredUsedUndeclaredDependency>software.amazon.awssdk:schema</ignoredUsedUndeclaredDependency>
                        <ignoredUsedUndeclaredDependency>software.amazon.awssdk:protocol-core</ignoredUsedUndeclaredDependency>
                    </ignoredUsedUndeclaredDependencies>
                </configuration>
                <executions>
                    <execution>
                        <!-- The feature build's service JARs and their runtime dependencies, as <artifactId>.jar -->
                        <id>copy-feature-jars</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>software.amazon.awssdk</includeGroupIds>
                            <excludeTransitive>false</excludeTransitive>
                            <includeScope>test</includeScope>
                            <stripVersion>true</stripVersion>
                            <outputDirectory>${project.build.directory}/size-report/feature-jars</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <size-report.baselineDir>${size-report.baselineDir}</size-report.baselineDir>
                        <size-report.featureJarsDir>${project.build.directory}/size-report/feature-jars</size-report.featureJarsDir>
                        <size-report.services>${size-report.services}</size-report.services>
                        <size-report.libraries>${size-report.libraries}</size-report.libraries>
                        <size-report.update>${size-report.update}</size-report.update>
                        <size-report.document>${size-report.docsDir}/size-report.md</size-report.document>
                        <size-report.disabledCustomizations>${size-report.docsDir}/disabled-customizations.md</size-report.disabledCustomizations>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
