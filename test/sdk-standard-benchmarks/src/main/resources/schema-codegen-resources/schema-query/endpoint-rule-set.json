{
    "version": "1.3",
    "parameters": {
        "Region": {
            "builtIn": "AWS::Region",
            "required": true,
            "documentation": "The AWS region used to dispatch the request.",
            "type": "String"
        },
        "UseDualStack": {
            "builtIn": "AWS::UseDualStack",
            "required": true,
            "default": false,
            "documentation": "When true, use the dual-stack endpoint.",
            "type": "Boolean"
        },
        "UseFIPS": {
            "builtIn": "AWS::UseFIPS",
            "required": true,
            "default": false,
            "documentation": "When true, use the FIPS endpoint.",
            "type": "Boolean"
        },
        "Endpoint": {
            "builtIn": "SDK::Endpoint",
            "required": false,
            "documentation": "Override the endpoint used to send this request",
            "type": "String"
        }
    },
    "rules": [
        {
            "conditions": [
                {
                    "fn": "isSet",
                    "argv": [
                        {
                            "ref": "Endpoint"
                        }
                    ]
                }
            ],
            "endpoint": {
                "url": {
                    "ref": "Endpoint"
                },
                "properties": {
                    "authSchemes": [
                        {
                            "name": "sigv4",
                            "signingRegion": "{Region}",
                            "signingName": "schemabenchquery"
                        }
                    ]
                },
                "headers": {}
            },
            "type": "endpoint"
        },
        {
            "conditions": [],
            "endpoint": {
                "url": "https://schemabenchquery.{Region}.amazonaws.com",
                "properties": {
                    "authSchemes": [
                        {
                            "name": "sigv4",
                            "signingRegion": "{Region}",
                            "signingName": "schemabenchquery"
                        }
                    ]
                },
                "headers": {}
            },
            "type": "endpoint"
        }
    ]
}
