        "restJson1-SdkRestJson": {
            "transforms": [
                {"name": "includeServices", "args": {"services": ["software.amazon.awssdk.protocoltests.restjson#SdkRestJson"]}},
                {"name": "removeUnusedShapes", "args": {}}
