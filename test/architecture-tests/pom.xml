    <artifactId>architecture-tests</artifactId>
    <name>AWS Java SDK :: Test :: Architecture Testing</name>
    <description>Test SDK architecture</description>
    <properties>
        <!-- Java 8 port-compliance check (PortComplianceTest, task 1.19) -->
        <port-compliance.asm.version>9.7</port-compliance.asm.version>
        <port-compliance.animal-sniffer.version>1.24</port-compliance.animal-sniffer.version>
        <port-compliance.java18-signature.version>1.0</port-compliance.java18-signature.version>
        <!--
          Schema-serde branch (OD-7): without -P fleet-services the non-prototype service classes are not on the
          classpath, and ArchUnit would prune their frozen violations from the committed archunit_store. The
          default build therefore freezes against a copy in target/; -P fleet-services uses the committed store.
        -->
        <archtests.freeze.storePath>${project.build.directory}/archunit_store</archtests.freeze.storePath>
        <!-- RacecarDecisionTableTest (task 9.1) runs the racecar decision table generator in its check mode -->
        <racecar-decisions.python>python3</racecar-decisions.python>
    </properties>
