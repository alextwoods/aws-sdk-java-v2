            <groupId>org.codehaus.mojo</groupId>
            <artifactId>animal-sniffer</artifactId>
            <version>${port-compliance.animal-sniffer.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The Java 8 API signature. Not a classpath artifact; its path is passed to the test (see surefire below). -->
        <dependency>
            <groupId>org.codehaus.mojo.signature</groupId>
            <artifactId>java18</artifactId>
            <version>${port-compliance.java18-signature.version}</version>
            <type>signature</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- Sets ${org.codehaus.mojo.signature:java18:signature} for PortComplianceTest -->
                        <id>port-compliance-signature-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!-- Skipping maven dependencies analysis to speed up the build -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Working copy of the frozen violations for the default (prototype-only) build -->
                        <id>copy-archunit-store</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/archunit_store</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/archunit_store</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <port.compliance.java18.signature>${org.codehaus.mojo.signature:java18:signature}</port.compliance.java18.signature>
                        <!-- Overrides archunit.properties (ArchUnit reads "archunit."-prefixed system properties) -->
                        <archunit.freeze.store.default.path>${archtests.freeze.storePath}</archunit.freeze.store.default.path>
                        <racecar-decisions.python>${racecar-decisions.python}</racecar-decisions.python>
                        <racecar-decisions.script>${project.basedir}/../../scripts/schema-serde/racecar_decisions.py</racecar-decisions.script>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Schema-serde branch (OD-7): these tests reference classes of non-prototype services
                      (S3), which the default reactor no longer builds. They compile and run with -P fleet-services.
                    -->
                    <testExcludes>
                        <testExclude>**/archtests/CodingConventionWithSuppressionTest.java</testExclude>
                        <testExclude>**/archtests/NamingConventionWithSuppressionTest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <!-- Skipping spotbugs for the generated JMH classes-->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
