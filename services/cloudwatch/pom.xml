<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>services</artifactId>
        <version>2.49.7-SNAPSHOT</version>
    </parent>
    <artifactId>cloudwatch</artifactId>
    <name>AWS Java SDK :: Services :: Amazon CloudWatch</name>
    <description>The AWS Java SDK for Amazon CloudWatch module holds the client classes that are used for communicating
        with Amazon CloudWatch Service
    </description>
    <url>https://aws.amazon.com/sdkforjava</url>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>software.amazon.awssdk.services.cloudwatch</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
              API compatibility with the Baseline_Build (task 3.35, Requirements 16.1, 16.2, 16.4, 16.6, 16.7).
              The root pom's japicmp execution compares this module's jar with the released
              ${project.artifactId}:${awsjavasdk.previous.version} (2.49.6, the merge base of this branch).
              CloudWatch is added to its includeModules and the baseline must resolve. Removed or changed public
              signatures fail the build and are named in its output; an accepted one must be listed, by fully
              qualified signature and with a reason, in docs/design/schema-serde/porting-deviations.md (section
              "services/cloudwatch public API compared with the Baseline_Build") and excluded here by signature.
              Of the root pom's overrides, METHOD_ADDED_TO_INTERFACE is dropped, so an abstract method declared on a
              public client or builder interface fails the build (Requirement 16.3).
              METHOD_ABSTRACT_ADDED_IN_IMPLEMENTED_INTERFACE is accepted here: japicmp 0.15.6 reports it for every
              final model class that now implements SerializableStruct, because it does not count
              SerializableStruct's default serialize() as implementing SerializableShape.serialize(). The
              "interfaces" execution below checks the public interfaces without accepting it.
            -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <configuration>
                    <parameter>
                        <includeModules combine.children="append">
                            <includeModule>cloudwatch</includeModule>
                        </includeModules>
                        <ignoreMissingOldVersion>false</ignoreMissingOldVersion>
                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                        <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
                        <overrideCompatibilityChangeParameters combine.self="override">
                            <overrideCompatibilityChangeParameter>
                                <compatibilityChange>METHOD_NEW_DEFAULT</compatibilityChange>
                                <binaryCompatible>true</binaryCompatible>
                                <sourceCompatible>true</sourceCompatible>
                            </overrideCompatibilityChangeParameter>
                            <overrideCompatibilityChangeParameter>
                                <compatibilityChange>METHOD_ABSTRACT_NOW_DEFAULT</compatibilityChange>
                                <binaryCompatible>true</binaryCompatible>
                                <sourceCompatible>true</sourceCompatible>
                            </overrideCompatibilityChangeParameter>
                            <overrideCompatibilityChangeParameter>
                                <compatibilityChange>METHOD_ABSTRACT_ADDED_IN_IMPLEMENTED_INTERFACE</compatibilityChange>
                                <binaryCompatible>true</binaryCompatible>
                                <sourceCompatible>true</sourceCompatible>
                            </overrideCompatibilityChangeParameter>
                        </overrideCompatibilityChangeParameters>
                    </parameter>
                </configuration>
                <executions>
                    <!--
                      japicmp reports the same change for an interface that now extends an interface with abstract
                      methods, which does break customer implementations. This second comparison covers the public
                      client, builder and waiter interfaces without accepting it.
                    -->
                    <execution>
                        <id>interfaces</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                        <configuration>
                            <parameter>
                                <includes>
                                    <include>software.amazon.awssdk.services.cloudwatch.*Client</include>
                                    <include>software.amazon.awssdk.services.cloudwatch.*Builder</include>
                                    <include>software.amazon.awssdk.services.cloudwatch.*Waiter</include>
                                </includes>
                                <overrideCompatibilityChangeParameters combine.self="override">
                                    <overrideCompatibilityChangeParameter>
                                        <compatibilityChange>METHOD_NEW_DEFAULT</compatibilityChange>
                                        <binaryCompatible>true</binaryCompatible>
                                        <sourceCompatible>true</sourceCompatible>
                                    </overrideCompatibilityChangeParameter>
                                    <overrideCompatibilityChangeParameter>
                                        <compatibilityChange>METHOD_ABSTRACT_NOW_DEFAULT</compatibilityChange>
                                        <binaryCompatible>true</binaryCompatible>
                                        <sourceCompatible>true</sourceCompatible>
                                    </overrideCompatibilityChangeParameter>
                                </overrideCompatibilityChangeParameters>
                            </parameter>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Generated Schema classes (<Svc>Schemas, <Svc>SchemaIndex, <Svc>ServiceSchemas; task 1.31). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>schema</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- The default client protocol (smithy.protocols#rpcv2Cbor), referenced by the generated base builder (task 3.23). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>rpcv2-cbor-client-protocol</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>aws-json-protocol</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>smithy-rpcv2-protocol</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>protocol-core</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>http-auth-aws</artifactId>
            <version>${awsjavasdk.version}</version>
        </dependency>
        <!-- CBOR round trips of generated model classes (task 3.7). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cbor-codec</artifactId>
            <version>${awsjavasdk.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
